# =============================================================================
# CRM API (Express + PostgreSQL).   cp backend/.env.example backend/.env
# =============================================================================
# Docker: database host is "db"  → postgresql://...@db:5432/...
# Local Node: postgresql://...@localhost:5432/...
# =============================================================================

PORT=3001

# Same password as POSTGRES_PASSWORD in the root .env
DATABASE_URL=postgresql://postgres:POSTGRES_PASSWORD@db:5432/real_avto_konkurs

# Always set in production: the API then refuses to start with a weak JWT_SECRET or the default CRM password.
NODE_ENV=production

# At least 32 characters: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h

# CRM admin account. The password is synced from here on every start (stored as a salted scrypt hash).
# Use 10+ characters.
CRM_ADMIN_USER=admin
CRM_ADMIN_PASSWORD=
# Browser origin(s) of the CRM, comma-separated, e.g. http://SERVER_IP:3000
# CORS_ORIGIN=http://127.0.0.1:3000,https://crm.example.com

# Connection pool (optional)
# PG_POOL_MAX=20
