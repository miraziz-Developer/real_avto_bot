# =============================================================================
# CRM backend (Express + PostgreSQL). Namuna: cp backend/.env.example backend/.env
# =============================================================================
# Docker: db xizmati hostname — postgresql://...@db:5432/...
# Mahalliy Node: postgresql://...@localhost:5432/...
# =============================================================================

PORT=3001

DATABASE_URL=postgresql://postgres:postgres@db:5432/real_avto_konkurs

# JWT — ishlab chiqarishda: openssl rand -hex 32
JWT_SECRET=change_me_super_secret
JWT_EXPIRES_IN=12h

# CRM birinchi kirish (brauzer login). Parolni darhol o‘zgartiring.
CRM_ADMIN_USER=admin
CRM_ADMIN_PASSWORD=admin123

# Ishlab chiqarish: NODE_ENV=production bo‘lsa zayif JWT/parol uchun ogohlantirish va CORS cheklovi
# NODE_ENV=production
# Brauzerdagi CRM manzillari (vergul bilan). Masalan docker-compose bilan http://SERVER_IP:3000
# CORS_ORIGIN=http://127.0.0.1:3000,https://crm.sizning-domen.uz

# PG pool (ixtiyoriy)
# PG_POOL_MAX=20
