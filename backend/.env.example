# =============================================================================
# CRM backend (Express + PostgreSQL). Namuna: cp backend/.env.example backend/.env
# =============================================================================
# Docker: db xizmati hostname — postgresql://...@db:5432/...
# Mahalliy Node: postgresql://...@localhost:5432/...
# =============================================================================

PORT=3001

# Parol — ildiz .env dagi POSTGRES_PASSWORD bilan bir xil.
DATABASE_URL=postgresql://postgres:POSTGRES_PAROLI@db:5432/real_avto_konkurs

# Ishlab chiqarishda ALBATTA. Shunda standart/zaif JWT_SECRET yoki CRM paroli bilan backend ishga tushmaydi.
NODE_ENV=production

# JWT — kamida 32 belgi: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h

# CRM admin login. Parol shu yerdan olinadi: o‘zgartirsangiz, backend restartida yangilanadi.
# Bazada tuzli scrypt xesh saqlanadi. 10+ belgi tavsiya etiladi.
CRM_ADMIN_USER=admin
CRM_ADMIN_PASSWORD=
# Brauzerdagi CRM manzillari (vergul bilan). Masalan docker-compose bilan http://SERVER_IP:3000
# CORS_ORIGIN=http://127.0.0.1:3000,https://crm.sizning-domen.uz

# PG pool (ixtiyoriy)
# PG_POOL_MAX=20
