# Public HTTPS entry (docker compose profile "proxy"). Certificates come from Let's Encrypt automatically.
# Hosts come from the root .env: PUBLIC_HOST (catalog + webhooks) and CRM_HOST (CRM).
# Without a domain, scripts/server_setup.sh uses <ip-with-dashes>.sslip.io, which resolves to the server IP.

{$CRM_HOST} {
	encode zstd gzip
	reverse_proxy frontend:80
}

{$PUBLIC_HOST} {
	encode zstd gzip
	# Instagram (Meta) webhook and ManyChat external requests → the bot's HTTP server
	handle /webhooks/* {
		reverse_proxy bot:8081
	}
	handle /manychat/* {
		reverse_proxy bot:8081
	}
	handle {
		reverse_proxy catalog:80
	}
}
