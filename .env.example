# =============================================================================
# Real Avto — ildiz .env (Telegram bot). Namuna: cp .env.example .env && nano .env
# =============================================================================
# To‘liq server qadamlari: DEPLOY.md
#
# Mahalliy «prodga yaqin» Docker: bash scripts/server_bootstrap.sh
#   — Postgres konteyneridagi standart parol postgres/postgres; host nomi db.
#   — REDIS_URL ni bo‘sh qoldiring: compose botga redis://redis:6379/0 beradi.
#   — Ishlab chiqarishda: SALE_FOLLOWUP daqiqa rejimi (SALE_FOLLOWUP_INTERVAL_MINUTES) ishlatmang.
# =============================================================================

# --- PostgreSQL (SQLAlchemy + asyncpg) ---
# docker-compose Postgres paroli (majburiy). Kuchli parol qo'ying va DATABASE_URL (bu yerda va backend/.env) da ham shuni yozing.
POSTGRES_PASSWORD=
# Docker Compose (bot konteyneridan): host db, DB nomi real_avto_konkurs
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/real_avto_konkurs
# Botni Docker’siz, mahalliy Postgres:
# DATABASE_URL=postgresql+asyncpg://USER:PAROL@localhost:5432/real_avto_konkurs

# --- Telegram (@BotFather) ---
BOT_TOKEN=

# --- Kanallar (ID: -100… yoki @username) ---
# Obuna tekshiruvi, e’lonlar, TOP — bot ushbu chatlarda admin bo‘lishi kerak.
CHANNEL_ID=
CHANNEL_USERNAME=
LEADERBOARD_CHANNEL_ID=

# Instagram (faqat username, @siz)
INSTAGRAM_USERNAME=

# --- Musobaqa (TOP / mukofot matni) ---
PRIZE_USD=50
LEADERBOARD_INTERVAL_DAYS=3

# --- Admin (e’lon moderatsiyasi: tasdiq / rad). Vergul bilan bir nechta ID ---
ADMIN_TELEGRAM_IDS=

# --- Savdo aloqa (kanal e’lonlari, wishlist, «sotilmadi» matnida tel havola) ---
# Bo‘sh qoldirsangiz test raqam ishlatiladi.
# Bir nechta raqam: vergul, nuqta-vergul yoki | bilan: +998901234567, +998909876543
SALES_PHONE=

# --- Narx kursi (USD ↔ so‘m taxminiy ko‘rsatishlar uchun, bazada narx USD) ---
USD_RATE_UZS=13000

# --- E'lon to'lovi (e'lon berish uchun moderatsiya oldidan kartaga to'lov) ---
# Hozircha e'lon bepul. Pullik rejim: LISTING_PAYMENT_ENABLED=true
LISTING_PAYMENT_ENABLED=false
LISTING_PRICE_UZS=50000
PAYMENT_CARD=8600123456789012
PAYMENT_CARD_HOLDER=Real Avto LLC


# --- AI (Groq): kanal postlarini tahlil qilish, ovoz/dumaloq videoni matnga aylantirish ---
# Bo'sh qoldirilsa kanal kuzatuvchi faqat oddiy (regex) tahlil bilan ishlaydi.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_STT_MODEL=whisper-large-v3

# --- AI savdo agenti (botga yozilgan savollarga bazadan javob, tayyor mijozni adminga topshirish) ---
AGENT_ENABLED=true
# GROQ_AGENT_MODEL=llama-3.3-70b-versatile
BUSINESS_NAME=Real Avto
BUSINESS_ADDRESS=Yangiyo'l
# Masalan: har kuni 9:00–20:00 (bo'sh bo'lsa agent ish vaqtini aytmaydi)
BUSINESS_HOURS=
# Adminga topshirilgan mijoz shuncha daqiqada olinmasa — qayta eslatma
LEAD_REMINDER_MINUTES=5

# --- Telegram Business (shaxsiy akkaunt chatlari) va kanal kommentlari ---
# Business: akkaunt egasi (Telegram Premium) Sozlamalar → Telegram Business → Chatbotlar → shu botni ulaydi.
BUSINESS_ENABLED=true
# Egasi mijozga o'zi yozsa, AI shu mijoz bilan shuncha soat jim turadi
BUSINESS_OWNER_PAUSE_HOURS=6
# Kommentlar: bot kanalga ulangan muhokama guruhida ADMIN bo'lishi kerak
COMMENTS_ENABLED=true

# --- E'lon muzlatish va «Sotib olamiz» ---
# Bot orqali kelgan e'lon shuncha ish soati jamoada turadi (sotib olish imkoniyati), keyin avtomatik kanalga. 0 — o'chirilgan
LISTING_FREEZE_HOURS=6
# Ish vaqti (Toshkent), soat
WORK_HOUR_START=9
WORK_HOUR_END=21
# Sotuvchi sotib olish taklifiga javob bermasa, shuncha soatdan keyin e'lon kanalga chiqadi
BUYOUT_REPLY_HOURS=24

# --- Mashinalar bazasi ---
# Shuncha kundan beri sotuvda turgan mashina uchun adminlarga «hali sotuvdami?» so'rovi
CAR_STALE_DAYS=14

# --- E’lon sotildi / sharh (ixtiyoriy override) ---
#
# Takroriy DM so‘rovi: asosiy jadval — soat (min 1). Ishlab chiqarishda odatda 24.
# SALE_FOLLOWUP_INTERVAL_HOURS=24
#
# Tez sinov uchun daqiqa rejimi (bo‘lsa soat maykun etiladi): masalan 3 daqiqa —
# tasdiqlangan e‘lon uchun ~3 daqiqadan keyin birinchi «sotildi/sotilmadi» xabari,
# worker tsikli ham qisqaroq uyqu bilan ishlaydi.
# SALE_FOLLOWUP_INTERVAL_MINUTES=3
#
# Birinchi DM uchun minimal kutish (daqiqa). Takroriy oralig‘dan qisqa bo‘lsa shu qisqaroq ishlatiladi.
# Bo‘sh qoldirsangiz: takror ≥2 soat bo‘lsa birinchi DM taxminan 1 soatdan keyin (oldingi mantiqda butun 24 soat kutardi).
# SALE_FOLLOWUP_FIRST_AFTER_MINUTES=45
#
# Sharhlar kanali (default kodda @real_avto_otzivlar). Boshqa kanal:
# REVIEWS_CHANNEL_ID=@real_avto_otzivlar
# Xarita havolasi (default Real Avto parking koordinatalari bilan)
# REAL_AVTO_MAP_URL=https://www.google.com/maps?q=41.148170,69.017201
# «Sotilmadi» javobida to‘liq o‘z HTML matningiz (bo‘sh bo‘lsa default + xarita):
# PARKING_LOCATION_TEXT=

# --- Redis (FSM: e’lon formasi va boshqalar) ---
# Docker: compose avtomatik beradi (REDIS_URL yozmasangiz ham bo‘ladi).
# Mahalliy: REDIS_URL=redis://localhost:6379/0
# REDIS_URL=

# --- Log va DB pool (ixtiyoriy) ---
# Mahalliy tekshiruv: INFO; ishlab chiqarishda ko‘pincha INFO yoki WARNING
# LOG_LEVEL=INFO
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=40
# DB_POOL_RECYCLE=3600
# DB_POOL_TIMEOUT=30

# =============================================================================
# ISHLAB CHIQARISH CHECKLIST (barcha tugmalar / funksiyalar uchun)
# =============================================================================
# [ ] BOT_TOKEN, CHANNEL_ID, CHANNEL_USERNAME, INSTAGRAM_USERNAME, LEADERBOARD_CHANNEL_ID
# [ ] ADMIN_TELEGRAM_IDS — kamida bitta ID
# [ ] SALES_PHONE — haqiqiy savdo raqami
# [ ] Bot: asosiy kanalda admin (post, obuna tekshiruvi)
# [ ] Bot: LEADERBOARD kanalida xabar yuborish
# [ ] Bot: @real_avto_otzivlar (yoki REVIEWS_CHANNEL_ID) da admin — sharhlar forward
# [ ] DATABASE_URL Dockerda @db hostname
# [ ] backend/.env — JWT_SECRET, CRM parol, DATABASE_URL (postgresql://...@db:5432/...)
# [ ] LOG_LEVEL=WARNING yoki INFO (prod)
# =============================================================================

# --- Mahalliy ishga tushirish (venv) ---
#   python -m venv .venv && source .venv/bin/activate
#   pip install -r requirements.txt
#   python -m bot.main
#
# --- Testlar ---
#   pip install -r requirements-dev.txt && pytest tests -q
#
# --- Docker ---
#   cp .env.example .env
#   cp backend/.env.example backend/.env   # JWT/parolni o‘zgartiring
#   bash scripts/server_bootstrap.sh
