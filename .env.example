# Python 3.11–3.13 tavsiya (aiogram/pydantic uchun); 3.14 hozircha muammoli bo‘lishi mumkin.

# PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/real_avto_konkurs

# Telegram bot (@BotFather)
BOT_TOKEN=

# Majburiy kanal: -100... yoki @kanalusername
CHANNEL_ID=

# Post va a'zolik tekshiruvi uchun (masalan: @real_avto_konkurs)
CHANNEL_USERNAME=

# Instagram profil (faqat username, @siz)
INSTAGRAM_USERNAME=

# Musobaqa kanaliga top-15 postlari (odatda majburiy kanal bilan bir xil bo‘lishi mumkin)
LEADERBOARD_CHANNEL_ID=

# So‘nggi mukofot matni
PRIZE_USD=50

# Avtomatik reyting postlari oralig‘i (kun)
LEADERBOARD_INTERVAL_DAYS=3

# Admin Telegram ID(lar) — vergul bilan. /message_to_users yoki /broadcast faqat shular uchun.
# O‘zingizni ID: @userinfobot yoki statistikadagi id.
ADMIN_TELEGRAM_IDS=


# Ishga tushirish: .env ni to‘ldirib, PostgreSQL yaratib, keyin:
#   python -m bot.main
# Bot kanalda a’zolikni tekshira olishi uchun kanalda admin bo‘lishi kerak.
# TOP postlari uchun LEADERBOARD_CHANNEL_ID kanalida ham xabar yuborish huquqi bo‘lsin.

# --- Docker (docker compose up -d) ---
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/real_avto_konkurs
# Mahalliy venv + alohida Postgres: @localhost ishlating.
# Testlar: pip install -r requirements-dev.txt && pytest

# --- Server (Docker) ---
# 1) Loyihani yuklang (git yoki rsync).
# 2) cp .env.example .env  &&  nano .env  (BOT_TOKEN, CHANNEL_ID, ...)
#    Docker ichida: DATABASE_URL=...@db:5432/real_avto_konkurs
# 3) bash scripts/server_bootstrap.sh
# Kanalda botni admin qiling (obuna tekshiruvi + TOP postlari).
