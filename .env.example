# =============================================================================
# Real Avto — root .env (Telegram bot).   cp .env.example .env && nano .env
# =============================================================================
# Full server guide: DEPLOY.md
#
# Docker (bash scripts/server_bootstrap.sh):
#   - the database host is "db";
#   - leave REDIS_URL empty: docker-compose passes redis://redis:6379/0 to the bot.
# =============================================================================

# --- PostgreSQL (SQLAlchemy + asyncpg) ---
# Password of the docker-compose Postgres (required). Use a strong one and repeat it
# in DATABASE_URL below and in backend/.env.
POSTGRES_PASSWORD=
# Inside Docker Compose: host "db", database "real_avto_konkurs"
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/real_avto_konkurs
# Running the bot without Docker against a local Postgres:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/real_avto_konkurs

# --- Telegram (@BotFather) ---
BOT_TOKEN=

# --- Channels (-100… id or @username) ---
# The bot must be an admin in these chats (subscription checks, listings, leaderboard).
CHANNEL_ID=
CHANNEL_USERNAME=
# Leaderboard posts; defaults to CHANNEL_ID
LEADERBOARD_CHANNEL_ID=

# Instagram username (without @)
INSTAGRAM_USERNAME=

# --- Contest (leaderboard / prize text) ---
PRIZE_USD=50
LEADERBOARD_INTERVAL_DAYS=3

# --- Admins: listing moderation, car and lead cards. Comma-separated Telegram user ids ---
ADMIN_TELEGRAM_IDS=

# --- Sales contact (channel posts, wishlist, "not sold" messages) ---
# Several numbers: separate with "," ";" or "|", e.g. +998901234567, +998909876543
SALES_PHONE=

# --- Exchange rate (approximate UZS display; prices are stored in USD) ---
USD_RATE_UZS=13000

# --- Listing fee (card payment before moderation) ---
# Listings are free by default. Paid mode: LISTING_PAYMENT_ENABLED=true
LISTING_PAYMENT_ENABLED=false
LISTING_PRICE_UZS=50000
PAYMENT_CARD=8600123456789012
PAYMENT_CARD_HOLDER=Real Avto LLC


# --- AI: channel posts, voice, round videos, videos and customer questions ---
# With no key the bot still works (rule-based parsing + template answers).
# AI_PROVIDER: auto (Gemini when GEMINI_API_KEY is set, otherwise Groq) | gemini | groq
AI_PROVIDER=auto

# Gemini (recommended): accurate Uzbek; hears AND sees videos (make, colour, mileage, speech).
# Key: https://aistudio.google.com/apikey (production needs a project with billing enabled)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite           # low cost; for higher accuracy use a larger Flash model (~3x cost)
# GEMINI_AGENT_MODEL=gemini-3.1-flash-lite     # customer conversations (defaults to GEMINI_MODEL)
# GEMINI_THINKING_LEVEL=low                    # low | medium | high (thinking tokens are billed)
# GEMINI_MEDIA_RESOLUTION=low                  # low: ~3x cheaper video; medium | high: more detail

# Groq (alternative): cheap text, but no video understanding and weak Uzbek speech recognition (Whisper)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_STT_MODEL=whisper-large-v3

# --- AI spending control ---
# Daily cap in USD (estimated). When reached, AI pauses until tomorrow and admins are notified. 0 = unlimited
AI_DAILY_BUDGET_USD=1
# AI replies / media analyses per customer per day (abuse protection). 0 = unlimited
AI_USER_DAILY_LIMIT=40
# Prices per 1M tokens (empty = provider defaults: Gemini Flash-Lite 0.25/1.50/0.50, Groq 0.15/0.60)
# AI_PRICE_INPUT_PER_M=
# AI_PRICE_OUTPUT_PER_M=
# AI_PRICE_AUDIO_PER_M=

# --- AI sales agent (answers from the inventory, hands qualified customers to admins) ---
AGENT_ENABLED=true
# GROQ_AGENT_MODEL=openai/gpt-oss-120b   # only with AI_PROVIDER=groq
BUSINESS_NAME=Real Avto
BUSINESS_ADDRESS=Yangiyo'l
# e.g. "every day 9:00–20:00" (empty = the agent does not mention opening hours)
BUSINESS_HOURS=
# Re-notify all admins when a handed-off customer is not taken within this many minutes
LEAD_REMINDER_MINUTES=5

# --- Telegram Business (owner's personal account) and channel comments ---
# Business: the account owner (Telegram Premium) adds the bot in Settings → Telegram Business → Chatbots.
BUSINESS_ENABLED=true
# When the owner writes to a customer personally, the AI stays silent with that customer for this many hours
BUSINESS_OWNER_PAUSE_HOURS=6
# Comments: the bot must be an ADMIN of the channel's discussion group
COMMENTS_ENABLED=true
# AI reads comments and group messages and replies by situation (questions, negative feedback; never to insults/spam)
COMMENTS_AI_ENABLED=true
# Answer an admin's own question in the group (useful for testing). Admin replies to customers are never interrupted.
COMMENTS_ANSWER_ADMINS=true
# Discussion group id (-100…). Empty = detected from the channel's automatic forwards
DISCUSSION_GROUP_ID=

# --- Catalog (website + Telegram Mini App) ---
# Catalog URL (HTTPS required for the Mini App), e.g. https://catalog.example.com
CATALOG_URL=
# CRM URL, shown to admins as the "🛠 Admin panel" menu button (HTTPS required)
CRM_URL=
# Bot username without @ (used by the catalog's "Ask a question" buttons)
BOT_USERNAME=

# --- Instagram (enable after Meta App Review) ---
# Webhook: https://YOUR-DOMAIN/webhooks/instagram → bot container, port IG_WEBHOOK_PORT
INSTAGRAM_ENABLED=false
IG_ACCESS_TOKEN=
IG_APP_SECRET=
# Any secret string; enter the same value as "Verify token" in the Meta dashboard
IG_VERIFY_TOKEN=
IG_ACCOUNT_ID=
IG_WEBHOOK_PORT=8081
# IG_GRAPH_VERSION=v21.0

# --- Listing freeze and buy-out offers ---
# Listings from the bot wait this many working hours (buy-out window) before auto-publishing. 0 = disabled
LISTING_FREEZE_HOURS=6
# Working hours (Tashkent time)
WORK_HOUR_START=9
WORK_HOUR_END=21
# Publish the listing if the seller does not answer a buy-out offer within this many hours
BUYOUT_REPLY_HOURS=24

# --- Inventory ---
# Ask admins "still for sale?" about cars listed longer than this many days
CAR_STALE_DAYS=7

# --- Sale follow-up / reviews (optional overrides) ---
# Repeat interval of the "sold / not sold?" DM to listing owners, in hours (min 1). Usually 24 in production.
# SALE_FOLLOWUP_INTERVAL_HOURS=24
#
# Minutes mode for quick testing only (overrides hours, shortens the worker sleep). Do not use in production.
# SALE_FOLLOWUP_INTERVAL_MINUTES=3
#
# Minimum wait before the first DM, in minutes. When empty and the interval is ≥ 2 hours,
# the first DM is sent after about 1 hour.
# SALE_FOLLOWUP_FIRST_AFTER_MINUTES=45
#
# Reviews channel (default: @real_avto_otzivlar)
# REVIEWS_CHANNEL_ID=@real_avto_otzivlar
# Map link (default: Real Avto parking coordinates)
# REAL_AVTO_MAP_URL=https://www.google.com/maps?q=41.148170,69.017201
# Custom HTML for the "not sold" reply (empty = default text + map)
# PARKING_LOCATION_TEXT=

# --- Redis (conversation state: listing forms etc.) ---
# Docker: provided by docker-compose. Local: REDIS_URL=redis://localhost:6379/0
# REDIS_URL=

# --- Logging and DB pool (optional) ---
# LOG_LEVEL=INFO
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=40
# DB_POOL_RECYCLE=3600
# DB_POOL_TIMEOUT=30

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# [ ] BOT_TOKEN, CHANNEL_ID, CHANNEL_USERNAME, INSTAGRAM_USERNAME
# [ ] ADMIN_TELEGRAM_IDS (at least one), SALES_PHONE (real number)
# [ ] POSTGRES_PASSWORD set and identical in both DATABASE_URLs
# [ ] GEMINI_API_KEY (voice and round videos are poor without it)
# [ ] Bot is admin in the main channel, its discussion group and the reviews channel
# [ ] backend/.env: JWT_SECRET, CRM_ADMIN_PASSWORD, DATABASE_URL (postgresql://...@db:5432/...)
# =============================================================================
#
# Local run without Docker:
#   python -m venv .venv && source .venv/bin/activate
#   pip install -r requirements.txt
#   python -m bot.main
# Tests:
#   pip install -r requirements-dev.txt && pytest tests -q
